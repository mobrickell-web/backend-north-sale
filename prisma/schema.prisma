// Prisma ORM schema — Appointment Booking & CRM
// Prisma 7: datasource url lives in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  USER
  SALES_REPRESENTATIVE
}

enum StaffPosition {
  /// Executive Account Development Specialist (EADS) — CRM /leads specialist.
  EXECUTIVE_ACCOUNT_DEVELOPMENT_SPECIALIST
  IMPLEMENTATION_SPECIALIST
  FRACTIONAL_VP
  REGIONAL_SALES_MANAGER
  OFFICE_MANAGER
}

enum OAuthProvider {
  GOOGLE
}

enum AuthCodePurpose {
  SIGNUP
  PASSWORD_RESET
}

enum ClientAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  /// Website booking form — awaiting Master Admin accept/reject (A6).
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentType {
  INITIAL_CONSULTATION
  SALES_PERFORMANCE_DISCUSSION
  SALES_PERFORMANCE_REVIEW
  FOLLOW_UP_MEETING
}

enum ActionType {
  BOOKED
  RESCHEDULED_BY_PROSPECT
  RESCHEDULED_BY_ADMIN
  CANCELLED_BY_PROSPECT
  CANCELLED_BY_ADMIN
  /// A6 — Master Admin accepted a pending website booking.
  ACCEPTED_BY_ADMIN
  /// A6 — Master Admin rejected a pending website booking.
  REJECTED_BY_ADMIN
  MARKED_COMPLETED_BY_ADMIN
  CONFIRMATION_EMAIL_SENT
  REMINDER_24H_SENT
  REMINDER_1H_SENT
  EMAIL_RESENT_BY_ADMIN
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentInstanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// EADS CRM — Current Status values (A8 + A13 Appointment Completed + A14 Do Not Contact).
enum LeadStatus {
  NEW_PROSPECT
  NO_ANSWER
  GATEKEEPER_REACHED
  DECISION_MAKER_REACHED
  CALLBACK_REQUIRED
  INTERESTED
  ZOOM_SCHEDULED
  /// A13 — manual CRM appointment marked completed.
  APPOINTMENT_COMPLETED
  PROPOSAL_SENT
  CLIENT_ACQUIRED
  NOT_INTERESTED
  NOT_QUALIFIED
  /// A14 — keep in DB; excluded from Active Leads / follow-up due buckets.
  DO_NOT_CONTACT
}

/// A12 — Annual Gross Revenue classification (Reported / Estimated / Unknown).
enum AnnualGrossRevenueKind {
  REPORTED
  ESTIMATED
  UNKNOWN
}

/// A12 — Existing Sales Force (Yes / No / Unknown).
enum ExistingSalesForce {
  YES
  NO
  UNKNOWN
}

/// Append-only CRM timeline entries (author name snapshotted at write time).
enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  /// A13 — manual CRM appointment marked completed.
  APPOINTMENT_COMPLETED
  /// Master Admin assigned / reassigned the lead to a Sales Representative.
  REASSIGNED
}

// -------------------------------------------------------------
// AUTHENTICATED ACCOUNTS
// AdminUser is the existing Prisma model/table name. It will temporarily store
// all account roles so the seeded Super Admin and current relations are kept.
// -------------------------------------------------------------

model AdminUser {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(120)
  email           String         @unique @db.VarChar(255)
  passwordHash    String?        @map("password_hash")
  /// Master-Admin credential handoff only — login still uses passwordHash.
  adminSetPassword String?       @map("admin_set_password") @db.Text
  role            Role           @default(USER)
  /// Staff position for SALES_REPRESENTATIVE accounts; null for other roles.
  position        StaffPosition? @map("position")
  isActive        Boolean        @default(true) @map("is_active")
  /// Set when access is paused; cleared on restore. Accounts are never deleted.
  accessPauseReason String?      @map("access_pause_reason") @db.Text
  accessPausedAt  DateTime?      @map("access_paused_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  performedLogs AppointmentLog[]

  refreshTokens          AdminRefreshToken[]
  oauthIdentities        OAuthIdentity[]
  verificationCodes      AuthVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
  clientAccessRequest    ClientAccessRequest?   @relation("ClientAccessRequester")
  reviewedAccessRequests ClientAccessRequest[]  @relation("ClientAccessReviewer")
  leads                    Lead[]
  leadActivities           LeadActivity[]
  leadFollowUpsCreated     LeadFollowUp[]      @relation("LeadFollowUpCreator")
  leadFollowUpsCompleted   LeadFollowUp[]      @relation("LeadFollowUpCompleter")
  assessmentResults        AssessmentResult[]

  @@map("admin_users")
}

model ClientAccessRequest {
  id              String             @id @default(uuid()) @db.Uuid
  account         AdminUser          @relation("ClientAccessRequester", fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String             @unique @map("account_id") @db.Uuid
  status          ClientAccessStatus @default(PENDING)
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      AdminUser?         @relation("ClientAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  rejectionReason String?            @map("rejection_reason") @db.Text

  @@index([status, requestedAt], name: "idx_client_access_status_requested")
  @@map("client_access_requests")
}

model OAuthIdentity {
  id                String        @id @default(uuid()) @db.Uuid
  account           AdminUser     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId         String        @map("account_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  providerEmail     String?       @map("provider_email") @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId], name: "uq_oauth_provider_account")
  @@unique([accountId, provider], name: "uq_account_oauth_provider")
  @@map("oauth_identities")
}

model AuthVerificationCode {
  id           String          @id @default(uuid()) @db.Uuid
  account      AdminUser       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String          @map("account_id") @db.Uuid
  purpose      AuthCodePurpose
  codeHash     String          @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(6)
  attemptCount Int             @default(0) @map("attempt_count")
  maxAttempts  Int             @default(5) @map("max_attempts")
  consumedAt   DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, purpose, createdAt], name: "idx_auth_code_account_purpose")
  @@index([expiresAt], name: "idx_auth_code_expiry")
  @@map("auth_verification_codes")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  account    AdminUser @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, expiresAt], name: "idx_password_reset_account_expiry")
  @@map("password_reset_tokens")
}

// -------------------------------------------------------------
// REFRESH TOKENS (Opaque, hashed-at-rest, rotated on use)
// -------------------------------------------------------------

model AdminRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId      String    @map("admin_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminId], name: "idx_refresh_token_admin")
  @@map("admin_refresh_tokens")
}

// -------------------------------------------------------------
// APPOINTMENTS (Master Booking Records)
// -------------------------------------------------------------

model Appointment {
  id String @id @default(uuid()) @db.Uuid
  contactName String @map("contact_name") @db.VarChar(150)
  companyName String @map("company_name") @db.VarChar(150)
  email String @db.VarChar(255)
  phone String? @db.VarChar(50)
  notes String? @db.Text

  appointmentType AppointmentType @default(INITIAL_CONSULTATION) @map("appointment_type")
  durationMinutes Int @default(30) @map("duration_minutes")

  scheduledAtUtc DateTime @map("scheduled_at_utc") @db.Timestamptz(6)
  prospectTimezone String @map("prospect_timezone") @db.VarChar(100)

  status AppointmentStatus @default(PENDING)
  rescheduleToken String @unique @default(uuid()) @map("reschedule_token") @db.Uuid
  cancelToken String @unique @default(uuid()) @map("cancel_token") @db.Uuid
  cancellationReason String? @map("cancellation_reason") @db.Text

  reminder24hSent Boolean @default(false) @map("reminder_24h_sent")
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at") @db.Timestamptz(6)
  reminder1hSent Boolean @default(false) @map("reminder_1h_sent")
  reminder1hSentAt DateTime? @map("reminder_1h_sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  history AppointmentLog[]
  emailDeliveries EmailDelivery[]

  @@index([scheduledAtUtc, status], name: "idx_appointment_schedule_status")
  @@index([email], name: "idx_appointment_email")
  @@index([rescheduleToken], name: "idx_appointment_reschedule_token")
  @@index([cancelToken], name: "idx_appointment_cancel_token")
  @@map("appointments")
}

// -------------------------------------------------------------
// CLIENT ENGAGEMENT MODELS
// -------------------------------------------------------------

enum ImprovementStatus {
  AGREED
  IN_PROGRESS
  DONE
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ReportType {
  QUARTERLY
  FINAL
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  COMPLETE
  DOWNLOAD
  ON_BEHALF
  ACCESS_ALLOW
  ACCESS_DENY
}

model BaselineMetric {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  metricKey   String   @db.VarChar(50)
  label       String   @db.VarChar(150)
  value       Float
  unit        String?  @db.VarChar(20)
  measuredAt  DateTime @db.Timestamptz(6)
  source      String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([clientId, metricKey])
}

model Improvement {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  title       String   @db.VarChar(150)
  description String?  @db.Text
  ownerName   String?  @db.VarChar(120)
  ownerSide   String?  @db.VarChar(20) // NPSG or CLIENT
  status      ImprovementStatus @default(AGREED)
  targetDate  DateTime?
  agreedAt    DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([clientId, status])
}

model KpiMeasurement {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  metricKey   String   @db.VarChar(50)
  value       Float
  measuredAt  DateTime @db.Timestamptz(6)
  target      Float?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([clientId, metricKey])
}

model ImplementationMilestone {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  title       String   @db.VarChar(150)
  startDate   DateTime?
  dueDate     DateTime?
  ownerName   String?  @db.VarChar(120)
  ownerSide   String?  @db.VarChar(20)
  status      MilestoneStatus @default(PLANNED)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@index([clientId, status])
}

model EngagementReport {
  id               String     @id @default(uuid()) @db.Uuid
  clientId         String     @db.Uuid
  title            String     @db.VarChar(150)
  type             ReportType @default(OTHER)
  period           String     @db.VarChar(100)
  publishedAt      DateTime?  @db.Timestamptz(6)
  fileKey          String     @db.VarChar(255)
  originalFileName String?    @map("original_file_name") @db.VarChar(255)
  contentType      String?    @map("content_type") @db.VarChar(120)
  summary          String?    @db.Text
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  @@index([clientId, type])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  action      AuditAction
  targetType  String   @db.VarChar(50)
  targetId    String   @db.Uuid
  clientId    String?  @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorId, targetType])
}


// -------------------------------------------------------------
// APPOINTMENT AUDIT & HISTORY LOGS
// -------------------------------------------------------------

model AppointmentLog {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  action       ActionType
  previousTime DateTime?  @map("previous_time") @db.Timestamptz(6)
  newTime      DateTime?  @map("new_time") @db.Timestamptz(6)
  notes        String?    @db.Text

  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([appointmentId], name: "idx_log_appointment_id")
  @@map("appointment_logs")
}

// -------------------------------------------------------------
// EMAIL DELIVERIES
// One row per outbound message, written the moment the SMTP server
// accepts it. `messageId` is the only handle that lets a later
// provider webhook be matched back to this appointment, so it is
// stored even though we do not yet consume webhooks.
// -------------------------------------------------------------

enum EmailDeliveryStatus {
  // Server accepted the message. Nothing is known about arrival yet.
  ACCEPTED
  // Final states — populated when a provider webhook lands.
  DELIVERED
  BOUNCED
  DEFERRED
  DROPPED
  SPAMREPORT
  UNSUBSCRIBED
}

model EmailDelivery {
  id            String       @id @default(uuid()) @db.Uuid
  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Normalised without angle brackets so provider webhooks match directly.
  messageId String? @map("message_id") @db.VarChar(255)

  /// Which template went out, e.g. BOOKING_CONFIRMATION / REMINDER_1H.
  kind      String  @db.VarChar(60)
  recipient String  @db.VarChar(255)
  subject   String? @db.VarChar(255)

  status       EmailDeliveryStatus @default(ACCEPTED)
  /// Provider-supplied explanation once a final status arrives.
  statusReason String?             @map("status_reason") @db.Text
  /// When the provider last reported a delivery event.
  statusAt     DateTime?           @map("status_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([messageId], name: "idx_email_delivery_message_id")
  @@index([appointmentId], name: "idx_email_delivery_appointment_id")
  @@index([status], name: "idx_email_delivery_status")
  @@map("email_deliveries")
}

// -------------------------------------------------------------
// ASSESSMENTS
// One row per authored assessment. `document` is the editor's whole
// content object (sections/questions/settings/resultText) stored as
// JSONB; identity and lifecycle live in the columns. Only PUBLISHED
// rows are ever returned by the public endpoint.
// -------------------------------------------------------------

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique @db.VarChar(120)
  title           String           @db.VarChar(200)
  status          AssessmentStatus @default(DRAFT)
  /// When true, this is the single client-facing assessment (dashboard/start).
  isClientPrimary Boolean          @default(false) @map("is_client_primary")
  document        Json             @db.JsonB
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  instances AssessmentInstance[]

  @@index([status], name: "idx_assessment_status")
  @@index([isClientPrimary], name: "idx_assessment_client_primary")
  @@map("assessments")
}

// One instance per client per assessment. Result JSON is client-safe only
// (overall/section scores + closer review). Scoring math stays server-side.
model AssessmentInstance {
  id                String                   @id @default(uuid()) @db.Uuid
  assessmentId      String                   @map("assessment_id") @db.Uuid
  assessment        Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  clientId          String                   @map("client_id") @db.Uuid
  status            AssessmentInstanceStatus @default(PENDING)
  answers           Json?                    @db.JsonB
  result            Json?                    @db.JsonB
  completedBy       String?                  @map("completed_by") @db.Uuid
  onBehalfOf        String?                  @map("on_behalf_of") @db.Uuid
  submittedAt       DateTime?                @map("submitted_at") @db.Timestamptz(6)
  onBehalfTokenHash String?                  @unique @map("on_behalf_token_hash") @db.VarChar(128)
  tokenExpiresAt    DateTime?                @map("token_expires_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clientId, assessmentId], name: "uq_assessment_instance_client_assessment")
  @@index([clientId, status], name: "idx_assessment_instance_client_status")
  @@map("assessment_instances")
}

// -------------------------------------------------------------
// LEADS (Account Development CRM — each lead has one assigned rep)
// Create requires companyName; default status NEW_PROSPECT.
// A11: ownerId nullable — Admin may create unassigned; EADS create is always self.
// -------------------------------------------------------------

model Lead {
  id     String     @id @default(uuid()) @db.Uuid
  owner  AdminUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Assigned EADS / Sales Representative. Null = unassigned (Admin pool).
  ownerId String? @map("owner_id") @db.Uuid

  companyName String     @map("company_name") @db.VarChar(200)
  website     String?    @db.VarChar(255)
  /// Legacy / general contact name (optional). Prefer decision-maker fields.
  name        String?    @db.VarChar(150)
  email       String?    @db.VarChar(255)
  phone       String?    @db.VarChar(50)
  address     String?    @db.Text

  gatekeeperName  String? @map("gatekeeper_name") @db.VarChar(150)
  gatekeeperPhone String? @map("gatekeeper_phone") @db.VarChar(50)

  decisionMakerName  String? @map("decision_maker_name") @db.VarChar(150)
  decisionMakerEmail String? @map("decision_maker_email") @db.VarChar(255)
  decisionMakerPhone String? @map("decision_maker_phone") @db.VarChar(50)

  /// A12 — Annual Gross Revenue amount (free-text as entered by the specialist).
  annualRevenue String? @map("annual_revenue") @db.VarChar(100)
  /// A12 — Reported / Estimated / Unknown.
  annualGrossRevenueKind AnnualGrossRevenueKind? @map("annual_gross_revenue_kind")
  /// A12 — Existing Sales Force Yes / No / Unknown.
  existingSalesForce ExistingSalesForce? @map("existing_sales_force")
  /// A12 — Number of Sales Representatives (preferred over free-text salesForceSize).
  numberOfSalesRepresentatives Int? @map("number_of_sales_representatives")
  /// Legacy free-text sales-force size; kept for older rows / CSV compat.
  salesForceSize String? @map("sales_force_size") @db.VarChar(100)
  /// A12 — Lead Source (free-text until client supplies a fixed list).
  leadSource String? @map("lead_source") @db.VarChar(150)

  status             LeadStatus @default(NEW_PROSPECT)
  /// Required when status = NOT_QUALIFIED.
  notQualifiedReason String?    @map("not_qualified_reason") @db.Text
  /// Required when status = CALLBACK_REQUIRED.
  followUpAt         DateTime?  @map("follow_up_at") @db.Timestamptz(6)
  followUpNotes      String?    @map("follow_up_notes") @db.Text
  /// Required when status = ZOOM_SCHEDULED (manual CRM appointment).
  appointmentAt      DateTime?  @map("appointment_at") @db.Timestamptz(6)
  appointmentNotes   String?    @map("appointment_notes") @db.Text
  /// A13 — when the scheduled appointment was marked completed (keeps appointmentAt).
  appointmentCompletedAt DateTime? @map("appointment_completed_at") @db.Timestamptz(6)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activities LeadActivity[]
  followUps  LeadFollowUp[]
  contacts   LeadContact[]

  @@index([ownerId], name: "idx_lead_owner")
  @@index([status], name: "idx_lead_status")
  @@index([companyName], name: "idx_lead_company_name")
  @@index([appointmentAt], name: "idx_lead_appointment_at")
  @@map("leads")
}

// -------------------------------------------------------------
// LEAD CONTACTS (A10 — multiple people under one company/prospect)
// -------------------------------------------------------------

model LeadContact {
  id      String  @id @default(uuid()) @db.Uuid
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId  String  @map("lead_id") @db.Uuid
  name    String  @db.VarChar(150)
  title   String? @db.VarChar(150)
  phone   String? @db.VarChar(50)
  email   String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  callActivities LeadActivity[]

  @@index([leadId], name: "idx_lead_contact_lead")
  @@map("lead_contacts")
}

// -------------------------------------------------------------
// LEAD ACTIVITIES (append-only call / email / note history)
// -------------------------------------------------------------

model LeadActivity {
  id         String           @id @default(uuid()) @db.Uuid
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String           @map("lead_id") @db.Uuid
  author     AdminUser?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?          @map("author_id") @db.Uuid
  /// Snapshot so the timeline keeps the author name if the account is removed.
  authorName String           @map("author_name") @db.VarChar(120)
  type       LeadActivityType
  body       String           @db.Text
  /// A9 — permanent call disposition (LeadStatus vocabulary). Null for non-call rows.
  disposition LeadStatus? @map("disposition")
  /// A9 — next follow-up noted when the call was logged (immutable on the row).
  nextFollowUpAt DateTime? @map("next_follow_up_at") @db.Timestamptz(6)
  /// A10 — contact spoken to (nullable for company-only / legacy rows).
  contact   LeadContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?      @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([leadId, createdAt], name: "idx_lead_activity_lead_created")
  @@index([leadId, type, createdAt], name: "idx_lead_activity_lead_type_created")
  @@index([contactId], name: "idx_lead_activity_contact")
  @@map("lead_activities")
}

// -------------------------------------------------------------
// LEAD FOLLOW-UPS (schedule + complete; overdue computed in API)
// -------------------------------------------------------------

model LeadFollowUp {
  id              String     @id @default(uuid()) @db.Uuid
  lead            Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId          String     @map("lead_id") @db.Uuid
  createdBy       AdminUser? @relation("LeadFollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById     String?    @map("created_by_id") @db.Uuid
  createdByName   String     @map("created_by_name") @db.VarChar(120)
  dueAt           DateTime   @map("due_at") @db.Timestamptz(6)
  notes           String?    @db.Text
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(6)
  completedBy     AdminUser? @relation("LeadFollowUpCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedById   String?    @map("completed_by_id") @db.Uuid
  completedByName String?    @map("completed_by_name") @db.VarChar(120)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([leadId, dueAt], name: "idx_lead_follow_up_lead_due")
  @@index([completedAt, dueAt], name: "idx_lead_follow_up_open_due")
  @@map("lead_follow_ups")
}

// -------------------------------------------------------------
// ASSESSMENT RESULTS
// Scored in the frontend; stored so results can be shown on the
// client dashboard.
// -------------------------------------------------------------

model AssessmentResult {
  id            String     @id @default(uuid()) @db.Uuid
  assessment    String     @db.VarChar(60)
  firstName     String     @map("first_name") @db.VarChar(120)
  /// Normalised to lowercase.
  email         String     @db.VarChar(255)
  overallScore  Int        @map("overall_score")
  maxScore      Int        @map("max_score")
  answers       Json
  result        Json
  submittedBy   AdminUser? @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submittedById String?    @map("submitted_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email], name: "idx_assessment_result_email")
  @@index([submittedById], name: "idx_assessment_result_submitted_by")
  @@map("assessment_results")
}
