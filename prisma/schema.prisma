// Prisma ORM schema — Appointment Booking & CRM
// Prisma 7: datasource url lives in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  USER
  SALES_REPRESENTATIVE
}

enum OAuthProvider {
  GOOGLE
}

enum AuthCodePurpose {
  SIGNUP
  PASSWORD_RESET
}

enum ClientAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentType {
  INITIAL_CONSULTATION
  SALES_PERFORMANCE_DISCUSSION
  SALES_PERFORMANCE_REVIEW
  FOLLOW_UP_MEETING
}

enum ActionType {
  BOOKED
  RESCHEDULED_BY_PROSPECT
  RESCHEDULED_BY_ADMIN
  CANCELLED_BY_PROSPECT
  CANCELLED_BY_ADMIN
  MARKED_COMPLETED_BY_ADMIN
  CONFIRMATION_EMAIL_SENT
  REMINDER_24H_SENT
  REMINDER_1H_SENT
  EMAIL_RESENT_BY_ADMIN
}

// -------------------------------------------------------------
// AUTHENTICATED ACCOUNTS
// AdminUser is the existing Prisma model/table name. It will temporarily store
// all account roles so the seeded Super Admin and current relations are kept.
// -------------------------------------------------------------

model AdminUser {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash")
  role            Role      @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  performedLogs AppointmentLog[]

  refreshTokens          AdminRefreshToken[]
  oauthIdentities        OAuthIdentity[]
  verificationCodes      AuthVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
  clientAccessRequest    ClientAccessRequest?   @relation("ClientAccessRequester")
  reviewedAccessRequests ClientAccessRequest[]  @relation("ClientAccessReviewer")

  @@map("admin_users")
}

model ClientAccessRequest {
  id              String             @id @default(uuid()) @db.Uuid
  account         AdminUser          @relation("ClientAccessRequester", fields: [accountId], references: [id], onDelete: Cascade)
  accountId       String             @unique @map("account_id") @db.Uuid
  status          ClientAccessStatus @default(PENDING)
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy      AdminUser?         @relation("ClientAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  rejectionReason String?            @map("rejection_reason") @db.Text

  @@index([status, requestedAt], name: "idx_client_access_status_requested")
  @@map("client_access_requests")
}

model OAuthIdentity {
  id                String        @id @default(uuid()) @db.Uuid
  account           AdminUser     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId         String        @map("account_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  providerEmail     String?       @map("provider_email") @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerAccountId], name: "uq_oauth_provider_account")
  @@unique([accountId, provider], name: "uq_account_oauth_provider")
  @@map("oauth_identities")
}

model AuthVerificationCode {
  id           String          @id @default(uuid()) @db.Uuid
  account      AdminUser       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId    String          @map("account_id") @db.Uuid
  purpose      AuthCodePurpose
  codeHash     String          @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(6)
  attemptCount Int             @default(0) @map("attempt_count")
  maxAttempts  Int             @default(5) @map("max_attempts")
  consumedAt   DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, purpose, createdAt], name: "idx_auth_code_account_purpose")
  @@index([expiresAt], name: "idx_auth_code_expiry")
  @@map("auth_verification_codes")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  account    AdminUser @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountId, expiresAt], name: "idx_password_reset_account_expiry")
  @@map("password_reset_tokens")
}

// -------------------------------------------------------------
// REFRESH TOKENS (Opaque, hashed-at-rest, rotated on use)
// -------------------------------------------------------------

model AdminRefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId      String    @map("admin_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([adminId], name: "idx_refresh_token_admin")
  @@map("admin_refresh_tokens")
}

// -------------------------------------------------------------
// APPOINTMENTS (Master Booking Records)
// -------------------------------------------------------------

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  contactName String  @map("contact_name") @db.VarChar(150)
  companyName String  @map("company_name") @db.VarChar(150)
  email       String  @db.VarChar(255)
  phone       String? @db.VarChar(50)
  notes       String? @db.Text

  appointmentType AppointmentType @default(INITIAL_CONSULTATION) @map("appointment_type")
  durationMinutes Int             @default(30) @map("duration_minutes")

  scheduledAtUtc   DateTime @map("scheduled_at_utc") @db.Timestamptz(6)
  prospectTimezone String   @map("prospect_timezone") @db.VarChar(100)

  status             AppointmentStatus @default(CONFIRMED)
  rescheduleToken    String            @unique @default(uuid()) @map("reschedule_token") @db.Uuid
  cancelToken        String            @unique @default(uuid()) @map("cancel_token") @db.Uuid
  cancellationReason String?           @map("cancellation_reason") @db.Text

  reminder24hSent   Boolean   @default(false) @map("reminder_24h_sent")
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at") @db.Timestamptz(6)
  reminder1hSent    Boolean   @default(false) @map("reminder_1h_sent")
  reminder1hSentAt  DateTime? @map("reminder_1h_sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  history         AppointmentLog[]
  emailDeliveries EmailDelivery[]

  @@index([scheduledAtUtc, status], name: "idx_appointment_schedule_status")
  @@index([email], name: "idx_appointment_email")
  @@index([rescheduleToken], name: "idx_appointment_reschedule_token")
  @@index([cancelToken], name: "idx_appointment_cancel_token")
  @@map("appointments")
}

// -------------------------------------------------------------
// APPOINTMENT AUDIT & HISTORY LOGS
// -------------------------------------------------------------

model AppointmentLog {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  action       ActionType
  previousTime DateTime?  @map("previous_time") @db.Timestamptz(6)
  newTime      DateTime?  @map("new_time") @db.Timestamptz(6)
  notes        String?    @db.Text

  adminUserId String?    @map("admin_user_id") @db.Uuid
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([appointmentId], name: "idx_log_appointment_id")
  @@map("appointment_logs")
}

// -------------------------------------------------------------
// EMAIL DELIVERIES
// One row per outbound message, written the moment the SMTP server
// accepts it. `messageId` is the only handle that lets a later
// provider webhook be matched back to this appointment, so it is
// stored even though we do not yet consume webhooks.
// -------------------------------------------------------------

enum EmailDeliveryStatus {
  // Server accepted the message. Nothing is known about arrival yet.
  ACCEPTED
  // Final states — populated when a provider webhook lands.
  DELIVERED
  BOUNCED
  DEFERRED
  DROPPED
  SPAMREPORT
  UNSUBSCRIBED
}

model EmailDelivery {
  id            String       @id @default(uuid()) @db.Uuid
  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Normalised without angle brackets so provider webhooks match directly.
  messageId String? @map("message_id") @db.VarChar(255)

  /// Which template went out, e.g. BOOKING_CONFIRMATION / REMINDER_1H.
  kind      String  @db.VarChar(60)
  recipient String  @db.VarChar(255)
  subject   String? @db.VarChar(255)

  status       EmailDeliveryStatus @default(ACCEPTED)
  /// Provider-supplied explanation once a final status arrives.
  statusReason String?             @map("status_reason") @db.Text
  /// When the provider last reported a delivery event.
  statusAt     DateTime?           @map("status_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([messageId], name: "idx_email_delivery_message_id")
  @@index([appointmentId], name: "idx_email_delivery_appointment_id")
  @@index([status], name: "idx_email_delivery_status")
  @@map("email_deliveries")
}
