# ── Application ──────────────────────────────────────
# PORT       — API port
# APP_URL    — public base URL of THIS API (used for .ics calendar links)
# FRONTEND_URL — public base URL of the Next.js site (reschedule/cancel links)
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Optional comma-separated browser origins. FRONTEND_URL and APP_URL are also
# included automatically for credentialed CORS and cookie-auth Origin checks.
# CORS_ORIGINS=https://northpointsalesgroup.com,https://www.northpointsalesgroup.com

# ── PostgreSQL (Prisma) ─────────────────────────────
# Dev DB runs in a dedicated Docker container: north-sales-postgres (port 5434).
#   docker run -d --name north-sales-postgres -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=mysecret123 -e POSTGRES_DB=north_sales \
#     -p 5434:5432 -v north-sales-pgdata:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL=postgresql://postgres:mysecret123@localhost:5434/north_sales?schema=public

# ── JWT (Super Admin auth) ──────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google sign-in ─────────────────────────────────
# OAuth 2.0 Web client ID used as the ID-token audience.
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET is not used by the ID-token verification flow.
# Keep any configured secret server-side; never expose it as NEXT_PUBLIC_*.

# ── Initial Super Admin seed (used in Chunk 1) ─────
INITIAL_ADMIN_EMAIL=admin@northpointsales.com
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── SMTP email delivery ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@northpointsalesgroup.com
SMTP_TO=contact@northpointsalesgroup.com
# MAIL_DRY_RUN=true logs would-be emails instead of sending.
# MAIL_DRY_RUN=true

# Copy the public key from SendGrid's signed Event Webhook settings.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# --- Reminder cron jobs (Chunk 7) ---
# REMINDERS_ENABLED=false pauses the 24h/1h reminder cron without code changes.
# REMINDER_LOOKBACK_MINUTES=5 is how wide the "due now" window is per tick.
#   A narrow window means a reminder missed while the server was down is skipped
#   rather than firing late in bulk.
REMINDERS_ENABLED=true
REMINDER_LOOKBACK_MINUTES=5